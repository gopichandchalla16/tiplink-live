# Google Gemini API Key - get free at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Your deployed app URL
NEXT_PUBLIC_APP_URL=https://tiplink-live.vercel.app

# MongoDB Atlas connection string (optional - falls back to in-memory store)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/tiplink
